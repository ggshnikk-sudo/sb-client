# Bash-скрипты и YAML обязаны быть с LF даже на Windows,
# иначе Git for Bash и GitHub Actions падают из-за \r.
* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.ico binary
*.icns binary
*.apk binary
*.jks binary
*.idsig binary
